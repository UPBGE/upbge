void Deringing(RectificationBox clippingBox, float3 &fColor)
{
    fColor = clamp(fColor, clippingBox.aabbMin, clippingBox.aabbMax);
}

float GetUpsampleLanczosWeight(float2 fSrcSampleOffset, float fKernelWeight)
{
    float2 fSrcSampleOffsetBiased = fSrcSampleOffset * float2(fKernelWeight);
    float fSampleWeight = Lanczos2ApproxSq(dot(fSrcSampleOffsetBiased, fSrcSampleOffsetBiased));
    return fSampleWeight;
}

float ComputeMaxKernelWeight(AccumulationPassCommonParams params, AccumulationPassData &data) {

    const float fKernelSizeBias = 1.0f + (1.0f / float2(DownscaleFactor()) - 1.0f).x;

    return ffxMin(float(1.99f), fKernelSizeBias);
}

float3 LoadPreparedColor(int2 iSamplePos)
{
    const float3 fRgb             = ffxMax(float3(0, 0, 0), LoadInputColor(iSamplePos)) * Exposure();
    const float3 fPreparedYCoCg   = RGBToYCoCg(fRgb);

    return fPreparedYCoCg;
}

